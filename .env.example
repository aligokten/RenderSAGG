# --- Sunucu ---
PORT=3000
# Konteyner/bulut ortamlarında dışarıdan erişim için 0.0.0.0 bırakın
HOST=0.0.0.0

# --- Web'de yayınlarken güvenlik ---
# Panel şifresi. BOŞ BIRAKILIRSA panel adresi bilen herkese açıktır ve
# sunucudaki API anahtarınızı harcayabilir. Herkese açık adreste mutlaka doldurun.
PANEL_PASSWORD=
# true yapılırsa kullanıcılar kendi API anahtarlarını panelden girebilir
# (anahtar sunucuda saklanmaz, loglanmaz; yalnızca o istek için kullanılır)
ALLOW_CLIENT_KEY=false
# IP başına saatlik üretim sınırı; 0 = sınırsız
RATE_LIMIT_PER_HOUR=20
# Ters vekil (Render/Fly/Nginx) arkasında gerçek IP için açık bırakın
TRUST_PROXY=true

# --- Görsel üretim sağlayıcısı ---
# gemini | openai | mock
# mock  -> API anahtarı gerektirmez, yerel görüntü işleme ile çalışır (AI üretimi DEĞİLDİR, panel testi içindir)
RENDER_PROVIDER=mock

# Google Gemini (image edit)
GEMINI_API_KEY=
# gemini-3 nesli görsel modeller imageConfig.imageSize destekler ve 4K'yı DOĞRUDAN üretir
# (yükseltmeye gerek kalmaz). Eski modellerde çıktı ~1K-2K olur, aradaki fark yükseltmeyle
# kapatılır ve sonuç künyesinde açıkça yazılır. Örn: gemini-3-pro-image-preview
GEMINI_MODEL=gemini-2.5-flash-image

# OpenAI görsel düzenleme
OPENAI_API_KEY=
# gpt-image-2 serbest boyut kabul eder ve 3840x2160'a kadar DOĞRUDAN üretir.
# gpt-image-1 / 1.5 ise 1024-1536 aralığıyla sınırlıdır; fark yükseltmeyle kapatılır.
OPENAI_MODEL=gpt-image-2
# low | medium | high | auto — maliyet ve süre bu ayarla artar
OPENAI_QUALITY=high

# --- Çıktı ---
# Nihai PNG uzun kenar (piksel). 3840 = 4K
OUTPUT_LONG_EDGE=3840
# Modele gönderilen girdinin uzun kenarı (yüksek = daha sadık mimari, daha yüksek maliyet)
INPUT_LONG_EDGE=2048
# Yüklenebilecek en büyük dosya (MB)
MAX_UPLOAD_MB=25
